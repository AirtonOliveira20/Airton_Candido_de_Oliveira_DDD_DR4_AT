meta {
  name: Reserva - Pagamento Recusado
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/reservas
  body: json
  auth: none
}

body:json {
  {
    "clienteId": "33333333-3333-3333-3333-333333333333",
    "sessaoId": "22222222-2222-2222-2222-222222222222",
    "assentos": ["A2"],
    "simularRecusaPagamento": true,
    "simularFalhaIngresso": false
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.reservaId) bru.setVar("reservaId", body.reservaId);
  if (body && body.pagamentoId) bru.setVar("pagamentoId", body.pagamentoId);
  if (body && body.clienteId) bru.setVar("clienteId", body.clienteId);
}
